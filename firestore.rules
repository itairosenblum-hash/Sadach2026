rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Accounts allowed to read / edit / delete registrations.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['itai.rosenblum@gmail.com', 'henshvarts@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function validUnit(u) {
      return u in ['אילת','אשדוד','קריה','עתלית','בצ"ת','מספנה','ב"ח','בה"ד'];
    }
    function validGender(g) {
      return g in ['זכר','נקבה'];
    }
    // Registration lock — set from admin.html (settings/registration.open)
    function regIsOpen() {
      return !exists(/databases/$(db)/documents/settings/registration)
        || get(/databases/$(db)/documents/settings/registration).data.get('open', true) != false;
    }
    function shortStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Full registration — anyone can create; only the admin can read/edit/delete.
    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['unit','role','rank','personalNum','name','phone','gender',
             'overnight','weapon','diet','notes','createdAt'])
        && regIsOpen()
        && validUnit(request.resource.data.unit)
        && validGender(request.resource.data.gender)
        && shortStr(request.resource.data.role, 80)
        && shortStr(request.resource.data.rank, 20)
        && shortStr(request.resource.data.personalNum, 15)
        && shortStr(request.resource.data.name, 80)
        && shortStr(request.resource.data.phone, 20)
        && request.resource.data.overnight in ['כן','לא']
        && request.resource.data.weapon in ['כן','לא']
        && request.resource.data.diet in ['רגיל','צמחוני','טבעוני']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Site settings edited from admin.html (contacts, instructions + gear) — everyone reads, only admins write.
    match /settings/{docId} {
      allow read: if docId in ['contacts', 'instructions', 'gallery', 'registration']
        || (docId == 'schedule' && (isAdmin() || resource.data.published == true));
      allow write: if isAdmin() && docId in ['contacts', 'instructions', 'schedule', 'gallery', 'registration']
        && request.resource.data.keys().hasOnly(['items', 'rules', 'gear', 'published', 'title', 'subtitle', 'days', 'uploadsOpen', 'open', 'message', 'updatedAt']);
    }

    // Room setup — admins only.
    match /settings/rooms {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['rooms', 'updatedAt'])
        && request.resource.data.rooms is list;
    }

    // Public rooms page: visible rooms, "open" = people may pick a room, "allowed" = {roomId: gender} they may pick.
    match /settings/roomsPublic {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['published', 'open', 'rooms', 'allowed', 'updatedAt'])
        && request.resource.data.published is bool
        && request.resource.data.open is bool
        && request.resource.data.rooms is list
        && request.resource.data.allowed is map;
    }

    function roomsCfg() {
      return get(/databases/$(db)/documents/settings/roomsPublic).data;
    }
    function roomSignupOpen() {
      return exists(/databases/$(db)/documents/settings/roomsPublic)
        && roomsCfg().get('published', false) == true
        && roomsCfg().get('open', false) == true;
    }
    // The personal number must be proven in the SAME write (roomKeys/{regId}.t == request.time).
    function provedNow(regId) {
      return getAfter(/databases/$(db)/documents/roomKeys/$(regId)).data.t == request.time;
    }

    // Write-only proof doc: only accepted when the personal number matches the registration.
    match /roomKeys/{regId} {
      allow read: if false;
      allow create, update: if roomSignupOpen()
        && request.resource.data.keys().hasOnly(['pn', 't'])
        && request.resource.data.t == request.time
        && exists(/databases/$(db)/documents/registrations/$(regId))
        && get(/databases/$(db)/documents/registrations/$(regId)).data.personalNum == request.resource.data.pn;
      allow delete: if isAdmin();
    }

    // Who is in which room — everyone can read. A person picks / changes / leaves their own room;
    // admins can pin anyone (locked: true), and a locked pick can't be changed by the person.
    match /roomPicks/{regId} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.resource == null || request.resource.data.keys().hasOnly(['room', 'name', 'unit', 'rank', 'gender', 'locked', 'updatedAt']));
      allow create, update: if roomSignupOpen()
        && provedNow(regId)
        && (resource == null || resource.data.get('locked', false) != true)
        && request.resource.data.keys().hasOnly(['room', 'name', 'unit', 'gender', 'locked', 'updatedAt'])
        && request.resource.data.locked == false
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(db)/documents/registrations/$(regId)).data.overnight == 'כן'
        && request.resource.data.name == get(/databases/$(db)/documents/registrations/$(regId)).data.name
        && request.resource.data.unit == get(/databases/$(db)/documents/registrations/$(regId)).data.unit
        && request.resource.data.gender == get(/databases/$(db)/documents/registrations/$(regId)).data.gender
        && roomsCfg().allowed.get(request.resource.data.room, '') == request.resource.data.gender;
      allow delete: if roomSignupOpen()
        && provedNow(regId)
        && resource.data.get('locked', false) != true;
    }

    // Attendance checks (bus / arrival roll calls) — admins only.
    match /attendance/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'scope', 'present', 'notes', 'createdAt'])
        && shortStr(request.resource.data.title, 80)
        && request.resource.data.scope in ['all', 'overnight']
        && request.resource.data.present is map
        && (!('notes' in request.resource.data) || request.resource.data.notes is map)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'scope', 'present', 'notes', 'createdAt'])
        && request.resource.data.present is map
        && (!('notes' in request.resource.data) || request.resource.data.notes is map);
    }

    // Public list shown on the site — unit, name, gender only.
    match /public_list/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['unit','name','gender','createdAt'])
        && validUnit(request.resource.data.unit)
        && validGender(request.resource.data.gender)
        && shortStr(request.resource.data.name, 80)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(db)/documents/registrations/$(id));
      allow update, delete: if isAdmin();
    }
  }
}
